USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36
REQUEST_TIMEOUT_MS=15000
# VPS: 3000=main, 3001=iputa — use 3002 para notice-api
PORT=3002
# VPS: reutiliza iputa-postgres (127.0.0.1:5433) com database dedicado
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/notice_api
CORS_ORIGIN=*
CRON_ENABLED=true
CRON_EXPRESSION=*/30 * * * *
# Retencao de artigos (limpeza automatica apos cada ingestao/cron)
ARTICLES_CLEANUP_ENABLED=true
ARTICLES_MAX_PER_CATEGORY=200
ARTICLES_MAX_AGE_DAYS=14
# Token para POST /ingestion/run e POST /cleanup/run (Bearer ou X-Runner-Token)
RUNNER_TOKEN=notice-runner-dev-token

# Shopee Affiliate Open API (https://affiliate.shopee.com.br/open_api/home)
SHOPEE_APP_ID=
SHOPEE_SECRET=
# Palavras-chave para buscar ofertas (separadas por vírgula)
SHOPEE_SYNC_KEYWORDS=oferta,promocao,desconto,eletronicos,moda
# Tipos: product, shop, campaign
SHOPEE_SYNC_TYPES=product,campaign
SHOPEE_SYNC_PAGE_LIMIT=50
SHOPEE_SYNC_MAX_PAGES=3
SHOPEE_PRODUCT_LIST_TYPE=1
SHOPEE_PRODUCT_SORT_TYPE=5
SHOPEE_FEATURED_COUNT=5
# Worker cron para sync Shopee (node-cron, padrão: a cada 6 horas)
SHOPEE_SYNC_ENABLED=true
SHOPEE_SYNC_CRON=0 */6 * * *
SHOPEE_SYNC_ON_START=false
# Cache das buscas live /shopee/* (segundos; 0 desliga cache)
SHOPEE_SEARCH_CACHE_TTL_SECONDS=900
SHOPEE_SEARCH_DEFAULT_LIMIT=20
SHOPEE_SEARCH_MAX_LIMIT=50
SHOPEE_SEARCH_MAX_KEYWORD_LENGTH=120
# Rate limit por IP nas rotas live /shopee/products|shops|campaigns|search
SHOPEE_LIVE_RATE_LIMIT_PER_MIN=60
# true = todas as buscas live exigem RUNNER_TOKEN
SHOPEE_LIVE_REQUIRE_TOKEN=false
# true = refresh=true exige RUNNER_TOKEN
SHOPEE_REFRESH_REQUIRE_TOKEN=true

# OpenRouter — tenta modelos free primeiro; fallback pago se free estourar limite
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
OPENROUTER_MAX_TOKENS=1024
OPENROUTER_FREE_MODELS=poolside/laguna-xs.2:free,liquid/lfm-2.5-1.2b-instruct:free,liquid/lfm-2.5-1.2b-thinking:free
# Modelo pago barato quando free atinge rate limit (ex.: google/gemini-2.0-flash-001)
OPENROUTER_PAID_FALLBACK_MODEL=meta-llama/llama-3.1-8b-instruct
OPENROUTER_ALLOW_PAID_FALLBACK=true
# Quantos artigos enriquecer por execução do cron (padrão 3 para respeitar limites)
ARTICLE_ENRICHMENT_BATCH_SIZE=3
# Pausa entre artigos em ms (padrão 12s — evita free-models-per-min)
ARTICLE_ENRICHMENT_DELAY_MS=12000
# Enriquecimento automático após cada ingestão no worker cron
ARTICLE_ENRICHMENT_ENABLED=true

# X (Twitter) — portal: https://developer.x.com/en/portal/dashboard
API_KEY_X=
API_SECRET_X=
X_BEARER_TOKEN=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_POST_MAX_INPUT_CHARS=3000
X_POST_WORKER_ENABLED=true
X_POST_WORKER_CRON=*/2 * * * *
X_POST_WORKER_ON_START=false
