{
  "name": "news-scraper",
  "version": "0.1.0",
  "description": "Plataforma de scraping com API, cron e PostgreSQL",
  "main": "src/api/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/api/server.js",
    "api:dev": "node --watch src/api/server.js",
    "scrape": "node src/index.js",
    "worker:cron": "node src/worker/cron.js",
    "db:migrate": "node src/db/migrate.js",
    "db:sanitize-summaries": "node scripts/sanitize-summaries.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/swagger": "^9.3.1",
    "@fastify/swagger-ui": "^5.2.1",
    "axios": "^1.9.0",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "fast-xml-parser": "^4.5.0",
    "fastify": "^5.0.0",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1"
  }
}
